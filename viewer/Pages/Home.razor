@page "/"
@using System.Text.Json
@using RailwayViewer.Overlay
@inject IConfiguration Configuration
@inject HttpClient Http

<PageTitle>Railway Tile Viewer</PageTitle>

<div class="viewer-shell">
    <SgbMap
        Center="@(new Coordinate(49.61, 6.13))"
        Zoom="8"
        Styles="@_styles"
        ComposedGlyphsUrl="@_composedGlyphsUrl"
        Display="@_display"
        Height="100%" />

    <aside class="filter-showcase" aria-label="Rail layer filtering showcase">
        <div class="panel-kicker">Normalized rail schema</div>
        <h1>Filter by family, mode, and lifecycle</h1>

        @if (_loadError is not null)
        {
            <p role="alert">@_loadError</p>
        }

        @foreach (var group in _groups)
        {
            <section class="filter-section" aria-labelledby="@($"{group.Id}-heading")">
                <h2 id="@($"{group.Id}-heading")">@group.Title</h2>
                <div class="toggle-grid compact">
                    @foreach (var toggle in group.Toggles)
                    {
                        <label class="toggle-chip" style="--accent:@(toggle.Swatch?.Color ?? "#64748b")">
                            <input
                                type="checkbox"
                                checked="@_display.IsOn(toggle.Token)"
                                disabled="@(!OverlayVisibility.IsAvailable(toggle))"
                                @onchange="@(args => _display.SetOn(toggle.Token, args.Value is true))" />
                            <span>@toggle.Label</span>
                        </label>
                    }
                </div>
            </section>
        }
    </aside>
</div>

@code {
    private const string OverlayStyleId = "lux-railway-overlay";

    private IReadOnlyList<MapStyle> _styles = [];
    private string? _composedGlyphsUrl;
    private readonly MapDisplayState _display = new([]);
    private IReadOnlyList<ToggleGroup> _groups = [];
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var tileServerUrl = Configuration.GetValue<string>("TileServerUrl") ?? "http://localhost:3000";
        var styleUrl = $"{tileServerUrl}/style.json";

        _styles = [MapStyle.OpenFreeMap.Positron, MapStyle.FromUrl(styleUrl).WithId(OverlayStyleId)];
        _composedGlyphsUrl = $"{tileServerUrl}/fonts/{{fontstack}}/{{range}}.pbf";

        try
        {
            using var style = JsonDocument.Parse(await Http.GetStringAsync(styleUrl));
            _groups = StyleToggleCatalog.Parse(style.RootElement);
            _display.Replace(OverlayVisibility.ToDisplayItems(OverlayStyleId, _groups));
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException)
        {
            _loadError = $"Could not load {styleUrl}: {exception.Message}";
        }
    }
}
